# Copy this file to .env for local overrides, or set these as environment
# variables in your hosting provider (e.g. Vercel project settings).

# Admin login credentials for the demo auth gate (client-side only — not real security)
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=cybertrace@2026

# Base URL of the deployed FastAPI backend, including /api.
# Leave unset for local dev (Vite proxy handles it).
# Example for production: VITE_API_BASE_URL=https://cybertrace-backend.onrender.com/api
VITE_API_BASE_URL=
